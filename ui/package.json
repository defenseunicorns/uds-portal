{
  "name": "uds-portal",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-or-later OR LicenseRef-Defense-Unicorns-Commercial",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "postinstall": "svelte-kit sync",
    "test": "pnpm run test:e2e && pnpm run test:unit",
    "lint": "pnpm run lint:all",
    "lint:all": "pnpm run lint:fix && pnpm run eslint && pnpm run svcheck",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "eslint": "eslint .",
    "svcheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "svcheck:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check": "pnpm run svcheck",
    "check:watch": "pnpm run svcheck:watch",
    "format": "pnpm run lint:fix",
    "test:e2e": "TEST_CFG=default playwright test",
    "test:e2e-local": "TEST_CFG=local playwright test",
    "test:install": "playwright install",
    "test:watch": "vitest",
    "test:unit": "vitest --run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource/inter": "5.3.0",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@kubernetes/client-node": "2.0.1",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "25.9.9",
    "autoprefixer": "10.6.1",
    "carbon-icons-svelte": "13.17.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.1",
    "flowbite": "4.0.2",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "kubernetes-fluent-client": "3.12.6",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.15.0",
  "type": "module"
}
